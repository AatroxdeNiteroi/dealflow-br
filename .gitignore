# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Dados brutos e processados — não comitar (dumps gigantes da Receita/RAIS).
# Reference tables (benchmark + razões) SIM vão pro repo — são output curado.
# data/estimates_v2.parquet (~6MB) também vai pro repo — output do motor, lido pela UI.
data/raw/
data/processed/
data/ibge_sidra/
data/validation/

# ⚠️ LGPD · parquets com dados pessoais NÃO vão pro Git público.
# Mover para storage privado autenticado (GCS bucket, R2 com signed URL etc.)
# e baixar em runtime/deploy. Estes arquivos JÁ FORAM COMITADOS em versões
# anteriores — para remover do histórico, ver `docs/lgpd-remediation.md`.
data/contato.parquet
data/socios_index.parquet
data/headcount_history.parquet

# PGFN Dívida Ativa — público (LAI) mas regenerável via scripts/refresh_pgfn.py.
# Atualiza trimestralmente; sai do repo para não inflar e ficar defasado.
data/pgfn_divida_ativa.parquet
# Datajud — público, regenerável via scripts/refresh_datajud.py (rápido).
data/datajud_rj_falencia.parquet
# Querido Diário — público, hoje só usado on-demand (sem batch).
data/querido_diario_mencoes.parquet

# Cache reproduzível da CVM (re-baixável via script). JSON hand-curated VAI pro repo.
data/cvm_cache/*.zip
data/cvm_cache/*.csv
data/cvm_cache/*.pdf
# Cache por-CNPJ do Portal da Transparência (re-baixável; dataset agregado
# data/contratos_federais_por_cnpj.json é o resultado e VAI pro repo).
data/cvm_cache/portal_transparencia/

# Baselines binários (parquet) — regeneráveis. Resultados txt vão pro repo.
data/baselines/*.parquet

# Misc
.env
.env.local
_*.txt

# Configs locais de tooling (Claude Code, skillfish) — não fazem parte do produto
.claude/
# skills/ é versionado como transporte de skills do Claude Code entre máquinas (ver skills/README.md)
