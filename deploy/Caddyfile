# Genesis Radar — Caddy (HTTPS automático + estático + proxy /api).
# Instalar: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Caddy tira e renova o cert Let's Encrypt sozinho; já manda o X-Forwarded-For
# correto (por isso DEALFLOW_TRUSTED_PROXY_HOPS=1 no backend).

app.genesisradar.com.br {
    encode gzip

    # ⚠️ Blocos `handle` (roteamento mutuamente exclusivo): /api/* PRECISA ir pro
    # backend ANTES do fallback SPA. Com um `try_files {path} /index.html` global,
    # o Caddy reescreve /api/* pra /index.html antes do reverse_proxy → toda rota
    # de API retorna o HTML do app. Os `handle` evitam isso.
    handle /api/* {
        # flush_interval -1 = equivalente ao proxy_buffering off do nginx
        # (necessário pros streams SSE de /api/v1/.../stream).
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    # resto: as 2 entries do build Vite — /landing.html é arquivo real (try_files
    # acha), todo o resto cai no index.html (o radar).
    handle {
        root * /opt/genesis/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
