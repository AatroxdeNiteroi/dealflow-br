# DealFlow API · template de configuração
# Copie este arquivo para `.env` (mesmo diretório) e preencha. NUNCA comite `.env`.
#
# Prefixo: todas as variáveis começam com DEALFLOW_ (ver settings.py).

# ────────────────────────────────────────────────────────────
# Segurança · LGPD art. 46
# ────────────────────────────────────────────────────────────

# Chave de API compartilhada (header X-Api-Key). Quando vazia, autenticação
# fica DESLIGADA — modo dev local. Em produção SEMPRE definir.
# Gere com: openssl rand -hex 32
DEALFLOW_API_KEY=

# Rate-limit por IP (req/min). 0 desativa. Default 60.
DEALFLOW_RATE_LIMIT_PER_MIN=60

# Ambiente: "dev" (default) ou "prod". Em prod, guardas de boot exigem gate de
# acesso (auth ou api_key) + COOKIE_SECURE e proíbem CORS "*" — falha FECHADO.
# Ver docs/security.md.
DEALFLOW_ENV=dev

# Proxy reverso confiável: nº de hops SEUS no X-Forwarded-For. 0 (default) = NÃO
# confia no header (usa o IP do socket). Atrás de 1 proxy (nginx/Caddy/Cloud LB
# que seta o XFF), use 1. Sem isto em prod, o rate-limit/audit usam o IP do
# proxy. Forjar o header sem proxy permitiria burlar o rate-limit.
DEALFLOW_TRUSTED_PROXY_HOPS=0

# Audit log (LGPD art. 37). Caminho de arquivo JSONL. Vazio → stderr.
DEALFLOW_AUDIT_LOG_PATH=

# ────────────────────────────────────────────────────────────
# CORS · whitelist de origens (CSV ou JSON-array)
# ────────────────────────────────────────────────────────────
# Default (dev): http://localhost:5173,http://localhost:3000
# Prod: defina os domínios reais:
#   DEALFLOW_CORS_ORIGINS=https://app.dealflowbr.com.br,https://staging.dealflowbr.com.br
DEALFLOW_CORS_ORIGINS=

# ────────────────────────────────────────────────────────────
# AI Search (Anthropic Claude)
# ────────────────────────────────────────────────────────────
# Sem a chave, POST /api/v1/search/ai retorna 503 com mensagem amigável.
# Pegue em console.anthropic.com → Settings → API Keys.
# ⚠️ LGPD art. 33 · transferência internacional · assinar DPA com Anthropic.
DEALFLOW_ANTHROPIC_API_KEY=

# Modelo (default: claude-haiku-4-5-20251001)
# DEALFLOW_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ────────────────────────────────────────────────────────────
# Protestos em cartório (CENPROT/IEPTB) · consulta on-demand
# ────────────────────────────────────────────────────────────
# A base nacional de protestos NÃO tem API pública livre (WAF + reCAPTCHA
# + login GOV.BR). A consulta passa por um provedor homologado, por CNPJ,
# com custo por consulta nova (~R$ 0,01–0,10), cacheada no backend.
# Sem provedor (default 'none'), o painel mostra "monitoramento sob demanda".
#   provider: none | infosimples | directd
DEALFLOW_PROTESTOS_PROVIDER=none
# Token do provedor escolhido (Infosimples: console; Direct Data: painel).
DEALFLOW_PROTESTOS_API_TOKEN=

# ────────────────────────────────────────────────────────────
# Auth · sessão por cookie JWT (fastapi-users)
# ────────────────────────────────────────────────────────────
# Secret do JWT + tokens de verificação/reset. Default é só para dev —
# em produção SEMPRE definir. Gere com: openssl rand -hex 32
# ⚠️ Deixe a linha comentada enquanto não tiver valor: vazia ela
# sobrescreve o default com "" (e com auth ligado o boot aborta).
# DEALFLOW_AUTH_SECRET=

# Cookie `genesis_session` só via HTTPS. Ligar em produção (true).
DEALFLOW_COOKIE_SECURE=false

# Gate das rotas de dados (/empresas, /filtros, /stats, /events...):
# exige sessão de usuário ativo e verificado. false = dev aberto (default).
DEALFLOW_AUTH_REQUIRED=false

# Gate adicional: exige assinatura ativa (subscription_status active/trialing).
DEALFLOW_REQUIRE_SUBSCRIPTION=false

# Banco de usuários (SQLite). Default: {repo}/data/users.db
# ⚠️ LGPD · contém dados pessoais — NUNCA comitar (já está no .gitignore).
DEALFLOW_USERS_DB_PATH=

# Base dos links de email (verify/reset) e redirects do Stripe Checkout.
# Default: http://localhost:5173 (Vite dev). Prod: domínio real do app.
DEALFLOW_APP_BASE_URL=

# ────────────────────────────────────────────────────────────
# Email transacional (Resend)
# ────────────────────────────────────────────────────────────
# Sem a chave, os emails saem no stderr com marcador [EMAIL] (dev/e2e).
# Obrigatória com DEALFLOW_AUTH_REQUIRED=true — sem ela o boot aborta
# (tokens de verify/reset e PII não podem vazar para os logs do host).
# Pegue em resend.com → API Keys.
DEALFLOW_RESEND_API_KEY=

# Remetente (default: Genesis Radar <radar@genesislabs.com.br>)
# DEALFLOW_EMAIL_FROM=Genesis Radar <radar@genesislabs.com.br>

# ────────────────────────────────────────────────────────────
# Stripe · assinaturas (Fase D)
# ────────────────────────────────────────────────────────────
# Sem as chaves, /billing/checkout, /portal e /webhook respondem 503
# (degradação graciosa). Crie os preços com: python scripts/stripe_seed.py
DEALFLOW_STRIPE_SECRET_KEY=
# Signing secret do endpoint de webhook (dashboard → Webhooks → endpoint).
DEALFLOW_STRIPE_WEBHOOK_SECRET=
